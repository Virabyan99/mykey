{
  "name": "mykey",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run pins:verify && pnpm run contracts:check && pnpm run db:check && pnpm run evidence:verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "pins:verify": "node scripts/pins-verify.ts",
    "stack:up": "node scripts/stack.ts up",
    "stack:down": "node scripts/stack.ts down",
    "stack:status": "node scripts/stack.ts status",
    "contracts:openapi": "node scripts/contracts-openapi.ts",
    "contracts:check": "node scripts/contracts-openapi.ts --check",
    "db:generate": "pnpm --dir packages/db exec drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:check": "node scripts/db-check.ts",
    "evidence:build": "node scripts/registry-build.ts",
    "evidence:verify": "node scripts/registry-verify.ts"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mykey/contracts": "workspace:*",
    "@mykey/db": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "catalog:",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "pg": "catalog:",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
