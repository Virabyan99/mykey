# The build context is the repository root (apps/api/Dockerfile). Everything is
# left out except what an image is built from, so no credential, test fixture
# or local state can end up in an image layer.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/api/package.json
!apps/api/src
!packages/contracts/package.json
!packages/contracts/src
!packages/db/package.json
!packages/db/src
!packages/audit/package.json
!packages/audit/src
!packages/operations/package.json
!packages/operations/src
!packages/openbao/package.json
!packages/openbao/src
!packages/auth/package.json
!packages/auth/src
!apps/provisioner/package.json
!apps/provisioner/src
# The policy templates the provisioner renders (Run 3.8); text, no secret.
!infra/openbao/policies
# The API reference asset script (Run 5.9); the asset stage of apps/api/Dockerfile runs it.
!scripts/reference-asset.ts
