ui            = false
disable_mlock = true
api_addr      = "https://openbao:8200"
cluster_addr  = "https://openbao:8201"

storage "raft" {
  path    = "/openbao/file"
  node_id = "dev-1"
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_cert_file   = "/pki/openbao.crt"
  tls_key_file    = "/pki/openbao.key"
}

# Development seal only: a 32-byte key generated by pki-init.sh into the pki
# volume. Real KMS unseal is proven on staging (Run 2.7).
seal "static" {
  current_key_id = "dev-1"
  current_key    = "file:///pki/openbao-static-seal.key"
}

# Audit device (P-21). OpenBao 2.7.2 refuses audit devices created through the
# API, so it is declared here. The `baoaudit` volume is made writable for the
# OpenBao uid by pki-init.sh: OpenBao does not answer a request it cannot audit.
audit "file" "main" {
  options {
    file_path = "/openbao/audit/audit.log"
    mode      = "0600"
  }
}
