#!/usr/sbin/nft -f
# MyKey host firewall (P-30, D-21).
#
# Loaded at boot by nftables.service (through /etc/nftables.conf) and by
# `mykey-egress.sh apply`. Only the table `inet mykey` is replaced: Docker owns
# its own tables and they are never flushed from here.
#
# All three chains run before Docker's (priority filter - 5) and have
# `policy drop`. A drop here is final; an accept here still has to pass
# Docker's chains.

define PUBLIC_IF = "ens3"

table inet mykey
delete table inet mykey

table inet mykey {
	# Fixed addresses the instance was given (D-21).
	set dns {
		type ipv4_addr
		flags timeout
		elements = { 213.186.33.99 }
	}

	set ntp {
		type ipv4_addr
		flags timeout
		elements = { 162.159.200.1, 162.159.200.123 }
	}

	# Filled by `mykey-egress.sh refresh` from egress-names.conf, 1 h per address.
	set acme {
		type ipv4_addr
		flags timeout
	}

	set kms {
		type ipv4_addr
		flags timeout
	}

	set r2 {
		type ipv4_addr
		flags timeout
	}

	set probe {
		type ipv4_addr
		flags timeout
	}

	set apt {
		type ipv4_addr
		flags timeout
	}

	# Empty except inside a maintenance window.
	set registry {
		type ipv4_addr
		flags timeout
	}

	# Addresses cut off by `mykey-egress.sh block`. Every element carries a
	# timeout, so a block always ends by itself, in the kernel.
	set blocked {
		type ipv4_addr
		flags timeout
	}

	chain input {
		type filter hook input priority filter - 5; policy drop;

		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept

		# Nothing new from a container network to the host.
		iifname "mk-*" drop

		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		icmp type echo-request limit rate 5/second accept
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
		icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		icmpv6 type echo-request limit rate 5/second accept

		# The public address comes from DHCP; a dropped renewal loses the host.
		iifname $PUBLIC_IF udp sport 67 udp dport 68 accept

		iifname $PUBLIC_IF udp dport 51820 accept
		iifname "wg0" tcp dport 22 accept
	}

	chain forward {
		type filter hook forward priority filter - 5; policy drop;

		meta nfproto ipv6 drop
		ip daddr @blocked drop
		ct state established,related accept
		ct state invalid drop

		# The one published port: 443 on the host, 8443 in `edge` (Docker's DNAT
		# has already happened when a packet reaches this hook).
		iifname $PUBLIC_IF oifname "mk-pub" tcp dport 8443 accept

		# Traffic between members of one bridge passes this hook when
		# br_netfilter is loaded.
		iifname "mk-edge" oifname "mk-edge" accept
		iifname "mk-db" oifname "mk-db" accept
		iifname "mk-bao" oifname "mk-bao" accept

		# Named destinations only. A container never gets a general 53 or 443.
		iifname "mk-pub" oifname $PUBLIC_IF ip daddr @acme tcp dport 443 accept
		iifname "mk-kms" oifname $PUBLIC_IF ip daddr @kms tcp dport 5696 accept
		iifname { "mk-pub", "mk-kms" } oifname $PUBLIC_IF ip daddr @dns meta l4proto { tcp, udp } th dport 53 accept
	}

	chain output {
		type filter hook output priority filter - 5; policy drop;

		oifname "lo" accept
		ip daddr @blocked reject with icmp type admin-prohibited
		ct state established,related accept

		# The host reaches its own containers (operator tunnels end here).
		oifname "mk-*" accept

		icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
		icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept
		icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept

		oifname $PUBLIC_IF udp sport 68 udp dport 67 accept
		oifname $PUBLIC_IF udp sport 51820 accept

		# The OpenStack metadata service: cloud-init asks it at every boot who
		# this instance is. No container bridge is allowed there; a container on
		# the host's network (the ops jobs, okms.sh) is the host (R6-1).
		oifname $PUBLIC_IF ip daddr 169.254.169.254 tcp dport 80 accept

		ip daddr @dns meta l4proto { tcp, udp } th dport 53 accept
		ip daddr @ntp udp dport 123 accept
		ip daddr @apt tcp dport { 80, 443 } accept
		ip daddr @probe tcp dport 443 accept
		ip daddr @r2 tcp dport 443 accept
		ip daddr @kms tcp dport 5696 accept
		ip daddr @registry tcp dport 443 accept

		# Refuse loudly instead of dropping: a local program fails at once and
		# falls back from IPv6 to IPv4 without waiting for a timeout.
		meta l4proto tcp reject with tcp reset
		reject with icmpx type admin-prohibited
	}
}

# Temporary rules (public SSH during lock-down, the revert drill). Absent in
# normal operation; a wildcard include matches nothing without an error.
include "/etc/nftables.d/mykey-temp-*.nft"
