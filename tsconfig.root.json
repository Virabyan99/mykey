{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "tsconfig.root.tsbuildinfo"
  },
  "include": [
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "infra/**/*.ts",
    "vitest.config.ts",
    "apps/cli/build.ts",
    "apps/web/build.ts",
    "packages/db/drizzle.config.ts"
  ],
  "exclude": ["**/dist", "**/node_modules", "tests/fixtures/ci"]
}
